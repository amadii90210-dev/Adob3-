{
  "name": "workhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WorkHub — wspólny hub pracy dla dwóch osób: repozytoria GitHub, modele AI (Ollama), chat, zadania i aktywność w czasie rzeczywistym (Socket.IO).",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
