# ============================================================
# WorkHub — konfiguracja (skopiuj do .env i uzupełnij)
#   cp .env.example .env
# ============================================================

# --- Serwer -------------------------------------------------
# Port, pod którym działa WorkHub
PORT=3000
# Na jaki interfejs słucha serwer. 0.0.0.0 = dostępny z całej sieci LAN (wymagane!)
HOST=0.0.0.0

# --- Modele AI ----------------------------------------------
# ollama  -> lokalny Ollama (domyślnie)
# openai  -> dowolne API zgodne z OpenAI (OpenAI, OpenRouter, Groq, LM Studio…)
AI_PROVIDER=ollama

# Adres lokalnego Ollama (uruchomione na maszynie, na której stoi serwer WorkHub)
OLLAMA_URL=http://localhost:11434

# Używane tylko gdy AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Domyślny model (używany, gdy lista modeli z API nie jest dostępna)
AI_MODEL=gpt-4o-mini

# --- GitHub ---------------------------------------------------
# Token (PAT) z uprawnieniami do odczytu repo. Puste = API anonimowe
# (tylko publiczne repozytoria, niskie limity zapytań).
GITHUB_TOKEN=

# --- Inne -----------------------------------------------------
# Maksymalna liczba użytkowników, którzy mogą się zarejestrować (domyślnie 2 —
# WorkHub jest projektowany dla dwóch osób, ale limit jest dowolnie podnoszany)
MAX_USERS=2

# Plik bazy danych (JSON). Pustka = data/workhub.json
DATA_FILE=
